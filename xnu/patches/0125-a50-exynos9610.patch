+
+/*
+ * Galaxy A50 Touchscreen Driver:
+ * Controller: MELFAS MMS400 / MSS100 on S3C2440 I2C-4 @ 0x13870000.
+ * Slave address: 0x48.
+ * ATTN / IRQ: GPA0_0 (pinctrl_alive 0x11850000 + 0x024, bit 0, active low).
+ * Protocol: MELFAS MIP 4.0, format 8 (EVENT_FORMAT_WITH_PRESSURE_2BYTE),
+ * 12-byte event packets.
+ * Coordinates: 0..4095 mapped to 1080x2340.
+ */
+#define A50_TOUCH_I2C_PA      0x13870000u
+#define A50_TOUCH_ALIVE_PA    0x11850000u
+#define A50_TOUCH_ADDR        0x48u
+
+static vm_offset_t a50_ts_i2c, a50_ts_alive;
+static int a50_ts_sleep;
+static bool a50_ts_down[5];
+static int a50_ts_x[5], a50_ts_y[5];
+
+static bool
+a50_s3c_wait_irq(vm_offset_t i2c)
+{
+	for (unsigned n = 0; n < 20000; n++) {
+		if (a5touch_read(i2c, 0x00) & 0x10u) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+a50_s3c_stop(vm_offset_t i2c)
+{
+	a5touch_write(i2c, 0x04, a5touch_read(i2c, 0x04) & ~0x20u);
+	a5touch_write(i2c, 0x00, a5touch_read(i2c, 0x00) & ~0x10u);
+	for (unsigned n = 0; n < 5000; n++) {
+		if (!(a5touch_read(i2c, 0x04) & 0x20u)) {
+			break;
+		}
+		delay(1);
+	}
+}
+
+static bool
+a50_s3c_xfer(vm_offset_t i2c, uint8_t addr, const uint8_t *wbuf, unsigned wlen, uint8_t *rbuf, unsigned rlen)
+{
+	if (!wlen && !rlen) {
+		return true;
+	}
+
+	for (unsigned n = 0; n < 5000; n++) {
+		if (!(a5touch_read(i2c, 0x04) & 0x20u)) {
+			break;
+		}
+		delay(1);
+	}
+
+	a5touch_write(i2c, 0x00, 0xe3u); /* ACK en, prescaler 3, IRQ en */
+	a5touch_write(i2c, 0x10, 7u);    /* S3C2440 SDA delay */
+
+	if (wlen) {
+		a5touch_write(i2c, 0x04, 0xd0u); /* Master Tx */
+		a5touch_write(i2c, 0x0c, (uint32_t)(addr << 1) | 0u);
+		delay(1);
+		a5touch_write(i2c, 0x04, 0xf0u); /* START */
+
+		if (!a50_s3c_wait_irq(i2c) || (a5touch_read(i2c, 0x04) & 1u)) {
+			a50_s3c_stop(i2c);
+			return false;
+		}
+		for (unsigned i = 0; i < wlen; i++) {
+			a5touch_write(i2c, 0x0c, wbuf[i]);
+			delay(1);
+			a5touch_write(i2c, 0x00, a5touch_read(i2c, 0x00) & ~0x10u);
+			if (!a50_s3c_wait_irq(i2c) || (a5touch_read(i2c, 0x04) & 1u)) {
+				a50_s3c_stop(i2c);
+				return false;
+			}
+		}
+	}
+
+	if (rlen) {
+		a5touch_write(i2c, 0x00, 0xe3u);
+		a5touch_write(i2c, 0x04, 0x90u); /* Master Rx */
+		a5touch_write(i2c, 0x0c, (uint32_t)(addr << 1) | 1u);
+		delay(1);
+		a5touch_write(i2c, 0x04, 0xb0u); /* Repeated START */
+		a5touch_write(i2c, 0x00, a5touch_read(i2c, 0x00) & ~0x10u);
+
+		if (!a50_s3c_wait_irq(i2c) || (a5touch_read(i2c, 0x04) & 1u)) {
+			a50_s3c_stop(i2c);
+			return false;
+		}
+		for (unsigned i = 0; i < rlen; i++) {
+			if (i + 1 == rlen) {
+				a5touch_write(i2c, 0x00, a5touch_read(i2c, 0x00) & ~0x80u); /* NACK on last */
+			}
+			a5touch_write(i2c, 0x00, a5touch_read(i2c, 0x00) & ~0x10u);
+			if (!a50_s3c_wait_irq(i2c)) {
+				a50_s3c_stop(i2c);
+				return false;
+			}
+			rbuf[i] = (uint8_t)a5touch_read(i2c, 0x0c);
+		}
+	}
+
+	a50_s3c_stop(i2c);
+	return true;
+}
+
+static void
+a50_ts_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&a50_ts_sleep, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+a50_touch_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	uint8_t buf[128];
+	unsigned errors = 0;
+	unsigned touch_log = 0;
+
+	printf("A50 TOUCH: worker thread running\n");
+	for (;;) {
+		/* ATTN pin is GPA0_0: 0x11850000 + 0x024 (GPA0_DAT), bit 0, active low */
+		if (a5touch_read(a50_ts_alive, 0x024) & 1u) {
+			a50_ts_wait(8);
+			continue;
+		}
+
+		/* Read packet info: 0x02, 0x10 */
+		uint8_t cmd_info[2] = { 0x02, 0x10 };
+		uint8_t pkt_info = 0;
+		if (!a50_s3c_xfer(a50_ts_i2c, A50_TOUCH_ADDR, cmd_info, 2, &pkt_info, 1)) {
+			if (++errors <= 5 || !(errors & 255)) {
+				printf("A50 TOUCH: read packet info failed (%u)\n", errors);
+			}
+			a50_ts_wait(10);
+			continue;
+		}
+
+		uint8_t sz = pkt_info & 0x7fu;
+		if (sz == 0) {
+			a50_ts_wait(4);
+			continue;
+		}
+		if (sz > 120) {
+			sz = 120;
+		}
+
+		/* Read packet data: 0x02, 0x11 */
+		uint8_t cmd_data[2] = { 0x02, 0x11 };
+		if (!a50_s3c_xfer(a50_ts_i2c, A50_TOUCH_ADDR, cmd_data, 2, buf, sz)) {
+			if (++errors <= 5 || !(errors & 255)) {
+				printf("A50 TOUCH: read packet data failed sz=%u (%u)\n", sz, errors);
+			}
+			a50_ts_wait(10);
+			continue;
+		}
+		errors = 0;
+
+		/* Parse 12-byte event packets (EVENT_FORMAT_WITH_PRESSURE_2BYTE) */
+		for (unsigned i = 0; i + 12 <= sz; i += 12) {
+			uint8_t *pkt = &buf[i];
+			uint8_t type = (pkt[0] & 0xf0u) >> 4;
+			if (type != 1) {
+				continue; /* 1 = SCREEN */
+			}
+			int id = (pkt[0] & 0x0fu) - 1;
+			if (id < 0 || id >= 5) {
+				continue;
+			}
+			int state = pkt[1] & 0x01u;
+			uint16_t rx = ((uint16_t)(pkt[2] & 0x0fu) << 8) | pkt[3];
+			uint16_t ry = ((uint16_t)((pkt[2] >> 4) & 0x0fu) << 8) | pkt[4];
+			int x = (int)rx * 1080 / 4095;
+			int y = (int)ry * 2340 / 4095;
+			if (x < 0) x = 0;
+			if (x > 1079) x = 1079;
+			if (y < 0) y = 0;
+			if (y > 2339) y = 2339;
+
+			if (state) {
+				if (!a50_ts_down[id]) {
+					if (touch_log < 30) {
+						printf("A50 TOUCH: DOWN id=%d raw=(%u,%u) xy=(%d,%d)\n",
+						    id, rx, ry, x, y);
+						touch_log++;
+					}
+				}
+				a50_ts_down[id] = true;
+				a50_ts_x[id] = x;
+				a50_ts_y[id] = y;
+				sweet_hid_touch(id, 1, x, y);
+			} else {
+				if (a50_ts_down[id]) {
+					if (touch_log < 30) {
+						printf("A50 TOUCH: UP id=%d xy=(%d,%d)\n",
+						    id, a50_ts_x[id], a50_ts_y[id]);
+						touch_log++;
+					}
+					a50_ts_down[id] = false;
+					sweet_hid_touch(id, 0, a50_ts_x[id], a50_ts_y[id]);
+				}
+			}
+		}
+	}
+}
+
+static void
+a50_touch_start(void)
+{
+	int enabled = 1;
+	(void)PE_parse_boot_argn("a5_touch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("a5touch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("A50 TOUCH: disabled by boot-arg\n");
+		return;
+	}
+
+	a50_ts_i2c = ml_io_map(A50_TOUCH_I2C_PA, 0x1000);
+	a50_ts_alive = ml_io_map(A50_TOUCH_ALIVE_PA, 0x1000);
+	if (!a50_ts_i2c || !a50_ts_alive) {
+		printf("A50 TOUCH: MMIO mapping failed (i2c=%p alive=%p)\n",
+		    (void *)a50_ts_i2c, (void *)a50_ts_alive);
+		return;
+	}
+
+	/* Probe check: read IC ID (0x01, 0x70) */
+	uint8_t cmd[2] = { 0x01, 0x70 };
+	uint8_t id_buf[4] = { 0 };
+	if (a50_s3c_xfer(a50_ts_i2c, A50_TOUCH_ADDR, cmd, 2, id_buf, 2)) {
+		printf("A50 TOUCH: MELFAS MSS100 detected (id %02x %02x)\n",
+		    id_buf[0], id_buf[1]);
+	} else {
+		printf("A50 TOUCH: MELFAS MSS100 probe xfer unconfirmed, starting worker anyway\n");
+	}
+
+	thread_t thread;
+	if (kernel_thread_start(a50_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("A50 TOUCH: worker thread started\n");
+	} else {
+		printf("A50 TOUCH: worker thread start failed\n");
+	}
+}
+
 void
 a5xelte_touch_probe(void)
 {
 #if defined(DREAMLTE)
-	dreamlte_touch_start();   /* the A5 path below stays off */
+	a50_touch_start();        /* A50 MELFAS MSS100 touch */
+	(void)dreamlte_touch_start;
 #endif
 	int enabled = A5_TOUCH_DEFAULT; /* A5 touch: off on the S8 */
 	int log_contacts = 0;
