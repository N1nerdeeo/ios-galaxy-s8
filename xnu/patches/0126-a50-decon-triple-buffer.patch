+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#define A5_DECON_PHYS           0x148B0000UL
+#define A5_DECON_SHADOW         0x060
+#define A5_DECON_SHADOW_GLOBAL  (1u << 31)
+#define A5_DECON_SHADOW_WINDOWS 0x3fu
+#define A5_IDMA_BASE_ADDR_Y     0x040
+#define A5_IDMA_ACTIVE          0x800
+#define A5_FB_BUF_STRIDE        0x00a00000ULL
+
+void
+AppleCLCD::deconSetupBuffers(void)
+{
+	fBufPhys[0] = fPhys;
+	fBufVirt[0] = fPixels;
+	fBufCount = 1;
+	fCurBuf = 0;
+
+	uint32_t reqBufs = 3;
+	PE_parse_boot_argn("sweetfb_bufs", &reqBufs, sizeof(reqBufs));
+	if (reqBufs <= 1 || (fPhys >> 32) != 0) {
+		IOLog("SWEET FB: single-buffer mode (sweetfb_bufs=%u)\n", reqBufs);
+		return;
+	}
+
+	static const uint32_t channels[] = { 0x14884000u, 0x14883000u, 0x14881000u, 0x14882000u };
+	for (size_t i = 0; i < sizeof(channels) / sizeof(channels[0]); i++) {
+		vm_offset_t idma = ml_io_map(channels[i], 0x1000);
+		if (idma != 0 && *(volatile uint32_t *)(idma + A5_IDMA_BASE_ADDR_Y) == (uint32_t)fPhys) {
+			fIdmaBase = idma;
+			IOLog("SWEET FB: matched DPP IDMA 0x%x for fb=0x%llx\n", channels[i], fPhys);
+			break;
+		}
+	}
+	if (fIdmaBase == 0) {
+		IOLog("SWEET FB: no DPP IDMA matches fb=0x%llx, keeping single buffer\n", fPhys);
+		return;
+	}
+
+	if (sweet_fb_decon == 0) {
+		sweet_fb_decon = ml_io_map(A5_DECON_PHYS, 0x1000);
+	}
+	fDeconBase = sweet_fb_decon;
+	if (fDeconBase == 0) {
+		IOLog("SWEET FB: DECON map failed, keeping single buffer\n");
+		return;
+	}
+
+	IOByteCount bufSize = (IOByteCount)round_page((vm_size_t)fRowBytes * fHeight);
+	size_t copyBytes = (size_t)fRowBytes * fHeight;
+	for (uint32_t i = 0; i < 2; i++) {
+		uint64_t phys = fPhys + (uint64_t)(i + 1) * A5_FB_BUF_STRIDE;
+		if ((phys >> 32) != 0) {
+			break;
+		}
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(
+		    (IOPhysicalAddress)phys, bufSize, kIODirectionInOut);
+		IOMemoryMap *map = md != NULL ? md->createMappingInTask(
+		    kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache) : NULL;
+		uintptr_t virt = map != NULL ? (uintptr_t)map->getVirtualAddress() : 0;
+		if (virt == 0) {
+			OSSafeReleaseNULL(map);
+			OSSafeReleaseNULL(md);
+			break;
+		}
+		fBufDesc[i] = md;
+		fBufMap[i] = map;
+		fBufPhys[i + 1] = phys;
+		fBufVirt[i + 1] = virt;
+		memcpy((void *)virt, (const void *)fBufVirt[0], copyBytes);
+	}
+
+	if (fBufVirt[1] != 0 && fBufVirt[2] != 0) {
+		fBufCount = 3;
+		IOLog("SWEET FB: DECON triple buffering enabled (0x%llx, 0x%llx, 0x%llx)\n",
+		    fBufPhys[0], fBufPhys[1], fBufPhys[2]);
+	} else {
+		for (uint32_t i = 0; i < 2; i++) {
+			OSSafeReleaseNULL(fBufMap[i]);
+			OSSafeReleaseNULL(fBufDesc[i]);
+			fBufPhys[i + 1] = 0;
+			fBufVirt[i + 1] = 0;
+		}
+		IOLog("SWEET FB: triple-buffer mapping failed, keeping single buffer\n");
+	}
+}
+#endif
